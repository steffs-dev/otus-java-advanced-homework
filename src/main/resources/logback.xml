<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Переменная для пути к папке с логами -->
    <property name="LOG_DIR" value="/log"/>
    <property name="APP_NAME" value="MyApp"/>

    <!-- 1. Аппендер для вывода в консоль -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Формат: Дата [Поток] Уровень ИмяКласса - Сообщение -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Аппендер для записи в файл (с ротацией по размеру и времени) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Имя файла при ротации (каждый день + индекс, если размер превышен) -->
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory> <!-- Хранить логи 30 дней -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Настройка уровней логирования для конкретных пакетов -->
    <logger name="src.main.java" level="DEBUG"/>
    <logger name="org.hibernate" level="WARN"/> <!-- Скрываем лишние логи БД -->

    <!-- Корневой логгер -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>